<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/aether_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/aether_background"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="BigRocket" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/aether_background"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="BigRocket"
            android:textColor="@color/br_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp"
            android:text="اتصال ترکیبی هوشمند Wi-Fi و دیتای همراه"
            android:textColor="@color/br_text_muted"
            android:textSize="13sp" />

        <!-- Network status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_br_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="وضعیت شبکه"
                android:textColor="@color/br_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvWifiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi: در حال بررسی..."
                android:textColor="@color/br_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvCellularStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cellular: در حال بررسی..."
                android:textColor="@color/br_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvPath3Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="مسیر ۳: قطع"
                android:textColor="@color/br_accent_cyan"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="امتیاز اعتبار مسیر"
                android:textColor="@color/br_text_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wi-Fi"
                    android:textColor="@color/br_text_primary"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/spinnerWifiScore"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_br_subsurface"
                    android:padding="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cellular"
                    android:textColor="@color/br_text_primary"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/spinnerCellularScore"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_br_subsurface"
                    android:padding="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- AI decision engine card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_br_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="موتور تصمیم‌گیری"
                android:textColor="@color/br_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="وضعیت AI: IDLE"
                android:textColor="@color/br_accent_cyan"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_br_subsurface"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="لاگ زنده هوش مصنوعی..."
                android:textColor="@color/br_accent_mint"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Performance card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_br_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="عملکرد"
                android:textColor="@color/br_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مود سیستم: Single-Path"
                android:textColor="@color/br_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="سرعت ترکیبی: 0.0 Mbps"
                android:textColor="@color/br_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Simple, cheap-to-render split bar: shows the live Wi-Fi vs Cellular
                 routing share. Plain weighted views only, no custom drawing - updated
                 by changing layout_weight. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_br_subsurface"
                android:clipToOutline="true"
                android:orientation="horizontal">

                <View
                    android:id="@+id/barWifi"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/br_wifi_bar" />

                <View
                    android:id="@+id/barCellular"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/br_cellular_bar" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvBarLegend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Wi-Fi 0% · Cellular 0%"
                android:textColor="@color/br_text_muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="روند سرعت (Mbps)"
                android:textColor="@color/br_text_muted"
                android:textSize="12sp" />

            <com.bigrocket.ui.SimpleLineChartView
                android:id="@+id/chartThroughput"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ADDRESS TUNNEL card (engine 2, in the phone).
             Placed above the static-IP card because it is the preferred egress: an address that
             is NOT a proxy - a plain IP, a DNS name, or a DoH endpoint - carries every flow in one
             multiplexed channel that is merged over both radios by the app itself. If the address
             fails its self-test, the app falls straight back to the card below (static proxy) or
             to direct, exactly as asked. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_br_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/address_tunnel_title"
                android:textColor="@color/br_text_muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/address_tunnel_help"
                android:textColor="@color/br_text_muted"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etTunnelAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_br_subsurface"
                android:hint="@string/address_tunnel_hint"
                android:importantForAutofill="no"
                android:inputType="textUri|textNoSuggestions"
                android:maxLines="2"
                android:padding="10dp"
                android:textColor="@color/br_text_primary"
                android:textColorHint="@color/br_text_muted"
                android:textDirection="ltr"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSaveTunnelAddress"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_br_button"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:stateListAnimator="@null"
                    android:text="@string/address_tunnel_save"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnClearTunnelAddress"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_br_subsurface"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:stateListAnimator="@null"
                    android:text="@string/address_tunnel_clear"
                    android:textAllCaps="false"
                    android:textColor="@color/br_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTunnelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/address_tunnel_off"
                android:textColor="@color/br_accent_cyan"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Static-IP proxy / virtual-VPS egress card.
             Sits directly above the Connect button on purpose: it configures WHERE the
             already-merged Path1+Path2 stream leaves from, so it is read as part of
             "what the connection will look like", not as a post-connect tweak. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_br_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="استاتیک آی‌پی (خروجی VPS مجازی)"
                android:textColor="@color/br_text_muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="مسیر ۱ و مسیر ۲ اول ترکیب می‌شوند، بعد خروجی از این پروکسی انجام می‌شود؛ پس آی‌پی عمومی همان آی‌پی پروکسی است."
                android:textColor="@color/br_text_muted"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etStaticProxy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_br_subsurface"
                android:hint="1.2.3.4:1080 یا socks5://user:pass@1.2.3.4:1080 یا http://1.2.3.4:8080"
                android:importantForAutofill="no"
                android:inputType="textUri|textNoSuggestions"
                android:maxLines="2"
                android:padding="10dp"
                android:textColor="@color/br_text_primary"
                android:textColorHint="@color/br_text_muted"
                android:textDirection="ltr"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSaveStaticProxy"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_br_button"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:stateListAnimator="@null"
                    android:text="ذخیره"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnClearStaticProxy"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_br_subsurface"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:stateListAnimator="@null"
                    android:text="حذف"
                    android:textAllCaps="false"
                    android:textColor="@color/br_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStaticProxyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="استاتیک آی‌پی: خاموش (خروجی مستقیم است)"
                android:textColor="@color/br_accent_cyan"
                android:textSize="13sp" />

            <!-- DNS address: replaces hardcoded static DNS servers. Plain IP or DoH URL. -->
            <EditText
                android:id="@+id/etDnsAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_br_subsurface"
                android:hint="@string/dns_user_hint"
                android:importantForAutofill="no"
                android:inputType="textUri|textNoSuggestions"
                android:maxLines="2"
                android:padding="10dp"
                android:textColor="@color/br_text_primary"
                android:textColorHint="@color/br_text_muted"
                android:textDirection="ltr"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSaveDnsAddress"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_br_button"
                android:fontFamily="sans-serif-medium"
                android:foreground="?android:attr/selectableItemBackground"
                android:stateListAnimator="@null"
                android:text="ذخیره دی ان اس"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCheckEgressIp"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_br_subsurface"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:stateListAnimator="@null"
                    android:text="بررسی آی‌پی خروجی"
                    android:textAllCaps="false"
                    android:textColor="@color/br_accent_mint"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvEgressIp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text=""
                    android:textColor="@color/br_text_primary"
                    android:textSize="12sp"
                    android:textDirection="ltr" />
            </LinearLayout>
        </LinearLayout>

        <!-- Xray config: above the connect button so it can be edited and saved
             without scrolling past everything. Shown only in the modes that use
             Xray (MainActivity toggles the visibility on the mode selection). -->
            <LinearLayout
                android:id="@+id/xrayConfigSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_br_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="کانفیگ Xray (لینک vless:// یا JSON کامل)"
                android:textColor="@color/br_text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etXrayConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_br_subsurface"
                android:gravity="top|start"
                android:hint="vless:// vmess:// trojan:// ss:// ... ، JSON یا لینک اشتراک"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:maxLines="8"
                android:minLines="3"
                android:padding="10dp"
                android:textColor="@color/br_text_primary"
                android:textColorHint="@color/br_text_muted"
                android:textDirection="ltr"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnImportXrayFile"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_br_button"
                android:fontFamily="sans-serif-medium"
                android:foreground="?android:attr/selectableItemBackground"
                android:stateListAnimator="@null"
                android:text="ورود کانفیگ از فایل"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSaveXrayConfig"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_br_button"
                android:fontFamily="sans-serif-medium"
                android:foreground="?android:attr/selectableItemBackground"
                android:stateListAnimator="@null"
                android:text="ذخیره کانفیگ Xray"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Connection card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_br_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvVpnStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="وضعیت VPN: غیرفعال"
                android:textColor="@color/br_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvUpstreamStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text=""
                android:textColor="@color/br_accent_error"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnToggleVpn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_br_button"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:foreground="?android:attr/selectableItemBackground"
                android:letterSpacing="0.01"
                android:stateListAnimator="@null"
                android:text="شروع اتصال VPN"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Optional Psiphon hop. Shown only in the chains that actually contain Aether
             (MainActivity toggles the visibility from the mode selection), OFF by default,
             and sitting between the Connect card and the Advanced routing card so the
             Connect button never moves. -->
        <LinearLayout
            android:id="@+id/psiphonHopSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_br_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="مرحله Psiphon (اختیاری)"
                android:textColor="@color/br_text_muted"
                android:textSize="12sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchPsiphonHop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:fontFamily="sans-serif-medium"
                android:text="اتصال به Psiphon بعد از Aether"
                android:textColor="@color/br_text_primary"
                android:textSize="14sp"
                app:switchPadding="10dp" />

            <TextView
                android:id="@+id/tvPsiphonHopStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="خاموش"
                android:textColor="@color/br_text_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/psiphonRegionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="کشور خروجی Psiphon"
                    android:textColor="@color/br_text_muted"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerPsiphonRegion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_br_subsurface"
                    android:padding="10dp"
                    android:popupBackground="@drawable/bg_br_card" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="«خودکار» یعنی Psiphon خودش بهترین خروجی ممکن را انتخاب می‌کند. یک کشور فقط وقتی انتخاب کنید که خروجی مشخص لازم دارید؛ Psiphon کشور انتخابی را فیلتر قطعی می‌داند."
                    android:textColor="@color/br_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Advanced routing card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_br_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="مسیر پیشرفته"
                android:textColor="@color/br_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAetherMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مسیر بعد از Bonding: Direct"
                android:textColor="@color/br_text_primary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerAetherMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_br_subsurface"
                android:padding="10dp"
                android:popupBackground="@drawable/bg_br_card" />

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/aetherEmbeddedPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

        </LinearLayout>

    </LinearLayout>
    </ScrollView>
</LinearLayout>
